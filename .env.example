# Copie ce fichier en .env et adapte les valeurs :
#   cp .env.example .env
# Ne commite jamais le fichier .env réel (il contient PLEX_TOKEN).
#
# Après le premier démarrage, la plupart de ces valeurs sont éditables
# directement depuis l'interface web (icône ⚙ Réglages) et sont alors
# persistées sur le volume Docker /data — .env ne sert plus alors qu'à
# amorcer la toute première configuration et à définir les montages de
# volumes (ce que Docker seul peut faire).

# --- Chemin hôte de ta bibliothèque média --------------------------------
# Monté par docker-compose.yml au même chemin à l'intérieur du conteneur
# (voir docker-compose.yml). Si tes films/séries sont éclatés sur plusieurs
# arborescences non liées (NAS + partage Freebox par ex.), ajoute une ligne
# `volumes:` supplémentaire dans docker-compose.yml pour chacune.
HOST_MEDIA_ROOT=/DATA/Media

# --- Chemins sources initiaux (doivent être sous HOST_MEDIA_ROOT, ou sous
# un des chemins que tu as ajoutés dans docker-compose.yml) ---------------
# Plusieurs valeurs séparées par des virgules sont acceptées.
# Modifiable ensuite depuis Réglages sans toucher à ce fichier.
SOURCE_DIRS_FILMS=/DATA/Media/Films
SOURCE_DIRS_SERIES=/DATA/Media/Series
SOURCE_DIRS_EBOOKS=/DATA/Media/Ebooks

# --- Sous-dossier ajouté sous le disque de destination choisi ------------
DEST_SUBDIR_FILMS=MEDIA/FILM
DEST_SUBDIR_SERIES=MEDIA/SERIES
DEST_SUBDIR_EBOOKS=MEDIA/EBOOKS

# --- Films adultes (facultatif) : dossiers séparés, classés à part -----------
# Vide = aucun dossier adulte. Doivent être montés dans le conteneur, comme les autres sources.
SOURCE_DIRS_ADULTES=
# Sous-dossier sur le disque pour les copies adultes. Vide = avec les autres films.
DEST_SUBDIR_ADULTES=MEDIA/ADULTE
# Code d'accès aux médias adultes : défini dans l'interface (Réglages › Comportement), jamais ici.

# --- Racines scannées pour détecter les disques externes montés ---------
DEST_SCAN_ROOTS=/media,/mnt,/run/media

# --- Marge de sécurité (octets) conservée sur le disque de destination ---
SAFETY_MARGIN_BYTES=524288000

# --- Extensions prises en compte pour la détection des fichiers ---------
VIDEO_EXTENSIONS=.mkv,.mp4,.avi,.m4v,.mov,.ts
EBOOK_EXTENSIONS=.epub,.mobi,.azw3,.azw,.pdf,.cbz,.cbr,.djvu

# --- Plex (laisser vide pour désactiver le filtre "vu / non vu" ET les
# métadonnées films — jaquette, note, genres) -----------------------------
# Token à récupérer toi-même : https://support.plex.tv/articles/204059436
# Éditable aussi depuis Réglages une fois l'appli lancée.
PLEX_URL=http://host.docker.internal:32400
PLEX_TOKEN=

# --- TMDB (jaquette, résumé, genres, note — complète les films que Plex ne
# reconnaît pas, ou si Plex n'est pas configuré). Il n'existe pas d'API
# IMDb publique officielle ; TMDB est la source standard utilisée par la
# plupart des outils de gestion de médiathèque. Clé gratuite sur
# https://www.themoviedb.org/settings/api — éditable aussi depuis Réglages.
TMDB_API_KEY=
TMDB_LANGUAGE=fr-FR

# --- 1fichier (compte premium) : sauvegarde des films en archives chiffrées --
# Clé API : compte 1fichier, section API. Éditable aussi depuis Réglages.
# Chaque film est envoyé dans un dossier tmdb-<id>, avec un mot de passe
# propre. Les mots de passe sont dans le fichier d'index du volume /data :
# sauvegarde ce volume, sinon les archives ne s'ouvrent plus.
ONEFICHIER_API_KEY=
# Dossier de travail des archives temporaires : il doit avoir la place d'un
# film (plusieurs Go) et être monté dans docker-compose.yml (même chemin).
# Modifiable dans Réglages › 1fichier, qui prime sur cette valeur une fois enregistré.
ONEFICHIER_STAGING_DIR=/MVE/TMP
# Compression 7z : 0 = aucune (conseillé pour la vidéo, déjà compressée), 9 = maximum.
ONEFICHIER_COMPRESSION=0
# Contrôle 1fichier hebdomadaire (liens, test de restauration) : jour (0 = lundi … 6 = dimanche) et heure locale.
ONEFICHIER_CHECK_WEEKDAY=6
# Nombre de tests de restauration par contrôle (1 archive par défaut, 20 Go au plus, une fois par mois et par archive).
ONEFICHIER_RESTORE_TESTS_PER_RUN=1
ONEFICHIER_CHECK_HOUR=3
# Alertes (facultatif) : URL d'un sujet ntfy (https://ntfy.sh/...) ou webhook Discord.
# Vide = aucune alerte. Modifiable dans Réglages › 1fichier.
NOTIFY_URL=
# Deuxième copie : dossier d'un disque externe monté où copier chaque archive chiffrée (vide = aucune).
ARCHIVE_COPY_DIR=
# Fuseau horaire du serveur : les plages de transfert (Réglages) et l'heure des contrôles en dépendent.
TZ=Europe/Paris
# Dossier des rapports SMART, rempli par l'hôte (scripts/disk_health.py) et lu en lecture seule.
HOST_HEALTH_DIR=/var/lib/archivage-health

# --- Radarr (films) et Sonarr (séries) (version 49) : quand on supprime un élément avec l'option
# « retirer aussi la fiche », sa fiche est retirée de l'application (elle ne sera plus cherchée ni téléchargée).
# Clé API : dans chaque application, Réglages › Général. Éditables aussi depuis Réglages.
RADARR_URL=
RADARR_API_KEY=
SONARR_URL=
SONARR_API_KEY=
# Action sur la fiche : retirer (défaut) ou desactiver (la fiche reste, mais n'est plus cherchée ni téléchargée).
ARR_ACTION=retirer

# --- Mode simulation : true pour tester une sélection sans rien écrire --
DRY_RUN=false

# --- Utilisateur du processus (version 45) : UID/GID du propriétaire de tes médias sur l'hôte.
# Vérifie avec `id -u` et `id -g` pour le compte qui possède /DATA/Media et /MVE/TMP.
PUID=1000
PGID=1000

# --- Interrupteur de suppression (version 45) : false = aucun fichier ne peut être supprimé
# (suppression, déplacement qui retire la source, suppression sur disque). Copies et renommages restent possibles.
ALLOW_DELETE=true

# --- Vérification après copie (version 45) : true = empreintes SHA-256 (recommandé, lit tout deux fois).
# false = comparaison des tailles seulement : plus rapide sur un disque lent, mais une altération de même taille passe inaperçue.
VERIFY_SHA256=true

# --- Jeton d'accès aux modifications (version 46) : vide = aucune protection (réseau local de confiance).
# Renseigné, toute modification (copier, déplacer, supprimer, réglages, envois) exige ce jeton. L'interface le demande
# une fois par navigateur. La lecture reste ouverte. Mets une longue valeur aléatoire, par exemple : openssl rand -hex 24
ACCESS_TOKEN=

# --- Texte exact que le frontend doit renvoyer pour confirmer une suppression
DELETE_CONFIRM_TEXT=SUPPRIMER

# Cache de la recherche : durée (secondes) avant reconstruction automatique des listes.
SEARCH_CACHE_SECONDS=900
